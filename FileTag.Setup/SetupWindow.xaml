<Window x:Class="FileTag.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="FileTag Setup" Width="540" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#1E1E2B">

    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="Dim" Color="#9B9BA8"/>
        <SolidColorBrush x:Key="Accent" Color="#4F8EF7"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#3D3D4D"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#28283A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Existing install detected -->
        <StackPanel x:Name="ExistingPanel" Grid.Row="0" Visibility="Collapsed">
            <TextBlock x:Name="ExistingTitle" Text="FileTag is already installed" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="ExistingText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                       Foreground="{StaticResource Dim}" Margin="0,10,0,0"/>
            <Border Style="{StaticResource Card}">
                <TextBlock FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                           Text="Updating is safe by construction: your notes live inside the files you tagged, and your settings live in %APPDATA% — an update cannot touch either."/>
            </Border>
            <StackPanel Margin="0,14,0,0">
                <Button x:Name="UpdateBtn" Style="{StaticResource AccentBtn}" Padding="14,9"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="Update_Click"/>
                <Button Content="Uninstall only (Setup will close)" Margin="0,8,0,0" Padding="14,9"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="UninstallFirst_Click"/>
                <TextBlock x:Name="WaitingText" Visibility="Collapsed" Margin="2,8,0,0" FontSize="12"
                           Foreground="{StaticResource Dim}" Text="Waiting for the uninstaller to finish…"/>
            </StackPanel>
        </StackPanel>

        <!-- 1. Welcome -->
        <StackPanel x:Name="WelcomePanel" Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏷" FontSize="30" Margin="0,0,12,0"/>
                <TextBlock Text="FileTag" FontSize="30" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="Attach a personal note to any file — stored invisibly with the file, synced across your PCs in Google Drive and OneDrive folders."
                       TextWrapping="Wrap" FontSize="13.5" Foreground="{StaticResource Dim}"
                       Margin="0,14,0,0" LineHeight="21"/>
            <Border Style="{StaticResource Card}">
                <TextBlock FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                           Text="Installs per-user — no administrator rights needed. Free, no account, nothing phones home."/>
            </Border>
        </StackPanel>

        <!-- 2. Location -->
        <StackPanel x:Name="LocationPanel" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Install location" FontSize="20" FontWeight="SemiBold"/>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" VerticalAlignment="Center"/>
                    <TextBox x:Name="DirBox" Background="#3D3D4D" Foreground="{StaticResource Text}"
                             BorderBrush="#5A5A6E" Padding="8,6" VerticalAlignment="Center"
                             CaretBrush="{StaticResource Text}"/>
                </DockPanel>
            </Border>
            <TextBlock Text="Per-user install — no admin prompt." FontSize="12"
                       Foreground="{StaticResource Dim}" Margin="2,10,0,0"/>
        </StackPanel>

        <!-- 3. Options -->
        <StackPanel x:Name="OptionsPanel" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Options" FontSize="20" FontWeight="SemiBold"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="StartupCheck" Content="Launch FileTag when Windows starts" IsChecked="True"/>
                    <CheckBox x:Name="LaunchCheck" Content="Launch FileTag after install" IsChecked="True"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 4. Progress -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Installing…" FontSize="20" FontWeight="SemiBold"/>
            <ProgressBar x:Name="Progress" Height="10" Margin="0,26,0,10" Background="#3D3D4D"
                         BorderThickness="0" Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="StepText" FontSize="12.5" Foreground="{StaticResource Dim}"/>
        </StackPanel>

        <!-- 5. Finish -->
        <StackPanel x:Name="FinishPanel" Grid.Row="0" Visibility="Collapsed">
            <TextBlock x:Name="FinishTitle" Text="FileTag is installed" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="FinishText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                       Foreground="{StaticResource Dim}" Margin="0,14,0,0"
                       Text="Select any file in Explorer and press Shift+Alt+N to add your first note."/>
            <StackPanel x:Name="FinishNotes" Margin="0,10,0,0"/>
            <Border x:Name="FinishGif" CornerRadius="8" Background="#101018" Padding="6" Margin="0,12,0,0"
                    HorizontalAlignment="Left">
                <Image gif:ImageBehavior.AnimatedSource="/Assets/filetag_demo.gif"
                       gif:ImageBehavior.RepeatBehavior="Forever" Height="150"/>
            </Border>
        </StackPanel>

        <!-- Footer buttons -->
        <DockPanel Grid.Row="1" Margin="0,20,0,0" LastChildFill="False">
            <TextBlock x:Name="StepCounter" DockPanel.Dock="Left" FontSize="11"
                       Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelBtn" Content="Cancel" Click="Cancel_Click"/>
                <Button x:Name="BackBtn" Content="Back" Click="Back_Click" Visibility="Collapsed"/>
                <Button x:Name="OpenSettingsBtn" Content="Open Settings" Click="OpenSettings_Click"
                        Visibility="Collapsed"/>
                <Button x:Name="NextBtn" Content="Next" Style="{StaticResource AccentBtn}" Click="Next_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
