<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>5.3.2</Version>
    <AssemblyName>FileTag.Setup</AssemblyName>
    <ApplicationIcon>..\FileTag.App\filetag.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileTag.Core\FileTag.Core.csproj" />
    <!-- payload.zip is placed here by build.ps1 right before publish -->
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
    <!-- same demo GIF + patch notes the app uses; embedded, never fetched -->
    <Resource Include="..\FileTag.App\Assets\filetag_demo.gif" Link="Assets\filetag_demo.gif" />
    <EmbeddedResource Include="..\FileTag.App\Assets\PatchNotes.json" Link="Assets\PatchNotes.json" />
    <Compile Include="..\FileTag.App\PatchNotes.cs" Link="PatchNotes.cs" />
  </ItemGroup>

</Project>
