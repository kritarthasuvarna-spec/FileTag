<Application x:Class="FileTag.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBackground"   Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SectionLabel"      Color="#666666"/>
    <SolidColorBrush x:Key="PrimaryText"       Color="#1A1A1A"/>
    <SolidColorBrush x:Key="AccentBlue"        Color="#0078D4"/>
    <SolidColorBrush x:Key="Separator"         Color="#D1D1D1"/>
    <SolidColorBrush x:Key="TextAreaBg"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PlaceholderText"   Color="#AAAAAA"/>
  </Application.Resources>
</Application>
