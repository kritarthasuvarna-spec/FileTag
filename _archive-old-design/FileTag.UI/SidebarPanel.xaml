<UserControl x:Class="FileTag.UI.SidebarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PanelBackground}"
             Padding="12,16,12,12">
  <StackPanel>
    <!-- File name -->
    <TextBlock x:Name="TxtFileName"
               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
               Foreground="{StaticResource PrimaryText}"
               TextTrimming="CharacterEllipsis" Margin="0,0,0,2"
               AutomationProperties.Name="File name"/>
    <!-- File type -->
    <TextBlock x:Name="TxtFileType"
               FontFamily="Segoe UI" FontSize="11"
               Foreground="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
    <!-- Metadata rows -->
    <StackPanel x:Name="PanelMeta">
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="70"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Size" Grid.Column="0"
                   FontFamily="Segoe UI" FontSize="11"
                   Foreground="{StaticResource SectionLabel}"/>
        <TextBlock x:Name="TxtSize" Grid.Column="1"
                   FontFamily="Segoe UI" FontSize="11"
                   Foreground="{StaticResource PrimaryText}"/>
      </Grid>
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="70"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Date modified" Grid.Column="0"
                   FontFamily="Segoe UI" FontSize="11"
                   Foreground="{StaticResource SectionLabel}"/>
        <TextBlock x:Name="TxtDate" Grid.Column="1"
                   FontFamily="Segoe UI" FontSize="11"
                   Foreground="{StaticResource PrimaryText}"/>
      </Grid>
    </StackPanel>

    <!-- Separator -->
    <Separator Margin="0,12" Background="{StaticResource Separator}"/>

    <!-- Relink prompt (shown on path mismatch) -->
    <StackPanel x:Name="PanelRelink" Visibility="Collapsed" Margin="0,0,0,8">
      <TextBlock Text="Note linked to previous filename. Re-link?"
                 FontFamily="Segoe UI" FontSize="11"
                 Foreground="{StaticResource SectionLabel}" TextWrapping="Wrap"/>
      <Button x:Name="BtnRelink" Content="Re-link" Margin="0,4,0,0"
              FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
              Foreground="{StaticResource AccentBlue}" Background="Transparent"
              BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand"
              Click="BtnRelink_Click"/>
    </StackPanel>

    <!-- Section label -->
    <TextBlock Text="💬 Comment"
               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
               Foreground="{StaticResource SectionLabel}" Margin="0,0,0,8"/>

    <!-- READ state -->
    <StackPanel x:Name="PanelRead" Visibility="Collapsed">
      <TextBlock x:Name="TxtComment"
                 FontFamily="Segoe UI" FontSize="12"
                 Foreground="{StaticResource PrimaryText}"
                 TextWrapping="Wrap" IsEnabled="True"
                 AutomationProperties.Name="Comment text"/>
      <TextBlock x:Name="TxtTimestamp"
                 FontFamily="Segoe UI" FontSize="10" FontStyle="Italic"
                 Foreground="{StaticResource PlaceholderText}" Margin="0,4,0,8"/>
      <Button x:Name="BtnModify" Content="Modify"
              FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
              Foreground="{StaticResource AccentBlue}" Background="Transparent"
              BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand"
              AutomationProperties.Name="Edit comment"
              Click="BtnModify_Click"/>
    </StackPanel>

    <!-- WRITE / EDIT state -->
    <StackPanel x:Name="PanelWrite" Visibility="Collapsed">
      <Grid>
        <TextBox x:Name="TxtInput"
                 FontFamily="Segoe UI" FontSize="12"
                 Background="{StaticResource TextAreaBg}"
                 BorderBrush="{StaticResource Separator}" BorderThickness="1"
                 Padding="6" TextWrapping="Wrap" AcceptsReturn="True"
                 MaxLength="500" MinHeight="80" MaxHeight="200"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Comment text"
                 KeyDown="TxtInput_KeyDown"
                 TextChanged="TxtInput_TextChanged"/>
        <TextBlock x:Name="TxtPlaceholder"
                   Text="Write your comment here..."
                   FontFamily="Segoe UI" FontSize="12"
                   Foreground="{StaticResource PlaceholderText}"
                   Margin="8,6,0,0" IsHitTestVisible="False"/>
      </Grid>
      <!-- Validation error -->
      <TextBlock x:Name="TxtError"
                 FontFamily="Segoe UI" FontSize="11"
                 Foreground="Red" Margin="0,2,0,0" Visibility="Collapsed"/>
      <!-- Char counter -->
      <TextBlock x:Name="TxtCounter"
                 FontFamily="Segoe UI" FontSize="10"
                 Foreground="{StaticResource PlaceholderText}"
                 HorizontalAlignment="Right" Margin="0,2,0,6"/>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnSave" Content="Save" Margin="0,0,8,0"
                FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                Foreground="{StaticResource AccentBlue}" Background="Transparent"
                BorderThickness="0" Cursor="Hand"
                AutomationProperties.Name="Save comment"
                Click="BtnSave_Click"/>
        <Button x:Name="BtnDiscard" Content="Discard"
                FontFamily="Segoe UI" FontSize="12"
                Foreground="{StaticResource SectionLabel}" Background="Transparent"
                BorderThickness="0" Cursor="Hand"
                AutomationProperties.Name="Discard changes"
                Click="BtnDiscard_Click"/>
      </StackPanel>
    </StackPanel>

    <Separator Margin="0,12,0,0" Background="{StaticResource Separator}"/>
  </StackPanel>
</UserControl>
