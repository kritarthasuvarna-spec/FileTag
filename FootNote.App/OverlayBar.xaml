<Window x:Class="FootNote.App.OverlayBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FootNote"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" SizeToContent="Height" Width="900">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="DimBrush" Color="#9B9BA8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F8EF7"/>

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="#F51E1E2B" CornerRadius="12,12,0,0"
            BorderBrush="#33FFFFFF" BorderThickness="1,1,1,0" Padding="18,11,18,13">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="0"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: file name · timestamp · actions -->
            <DockPanel Grid.Row="0" Margin="0,0,0,7" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="📝" FontSize="13" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="FileNameText" DockPanel.Dock="Left" FontWeight="SemiBold"
                           FontSize="13" Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="TimestampText" FontSize="11" Foreground="{StaticResource DimBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button x:Name="EditButton" Content="Edit" Style="{StaticResource BarButton}"
                            Click="EditButton_Click"/>
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click">
                        <Button.Style>
                            <!-- warning red on hover: visually distinct from routine actions -->
                            <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#C24242"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="CloseButton" Content="✕" Style="{StaticResource BarButton}"
                            Padding="9,5" Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>

            <!-- Read mode -->
            <TextBlock x:Name="CommentText" Grid.Row="1" TextWrapping="Wrap" FontSize="13.5"
                       Foreground="{StaticResource TextBrush}" LineHeight="19"/>

            <!-- Delete confirm (inline, never a modal popup) -->
            <DockPanel x:Name="ConfirmPanel" Grid.Row="1" Visibility="Collapsed" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TextBrush}"
                           Text="Delete this comment? This can't be undone after the grace period."/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ConfirmDeleteBtn" Content="Delete" Style="{StaticResource BarButton}"
                            Background="#C24242" Click="ConfirmDelete_Click"/>
                    <Button Content="Cancel" Style="{StaticResource BarButton}" Background="Transparent"
                            BorderThickness="0" Click="ConfirmCancel_Click"/>
                </StackPanel>
            </DockPanel>

            <!-- Edit mode -->
            <Grid x:Name="EditPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="EditBox" Grid.Row="0" MaxLength="500" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="58" MaxHeight="110"
                         VerticalScrollBarVisibility="Auto" FontSize="13.5"
                         Background="#3D3D4D" Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource TextBrush}" BorderBrush="#5A5A6E"
                         BorderThickness="1" Padding="8,6"
                         TextChanged="EditBox_TextChanged" PreviewKeyDown="EditBox_PreviewKeyDown"/>

                <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Ctrl+Enter to save  ·  Esc to discard  ·  save empty to remove"
                               FontSize="11" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="CharCounter" Text="0/500" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                        <Button Content="Save" Style="{StaticResource AccentButton}" Click="SaveButton_Click"/>
                        <Button Content="Discard" Style="{StaticResource BarButton}" Click="DiscardButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
