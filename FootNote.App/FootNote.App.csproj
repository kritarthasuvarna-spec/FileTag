<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>5.7.0</Version>
    <ApplicationIcon>footnote.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>FootNote</AssemblyTitle>
    <Product>FootNote</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FootNote.Core\FootNote.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- embedded, never fetched over the network -->
    <Resource Include="Assets\footnote_demo.gif" />
    <EmbeddedResource Include="Assets\PatchNotes.json" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
