<Window x:Class="FootNote.App.PatchNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New in FootNote" Width="480" Height="520" MinHeight="320"
        WindowStartupLocation="CenterScreen" Background="#1E1E2B">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="What's New" FontSize="22" FontWeight="SemiBold" Foreground="#F2F2F7"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel x:Name="NotesPanel"/>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Padding="18,7" Margin="0,14,0,0"
                Background="#3D3D4D" Foreground="#F2F2F7" BorderThickness="0" Click="Close_Click"/>
    </Grid>
</Window>
