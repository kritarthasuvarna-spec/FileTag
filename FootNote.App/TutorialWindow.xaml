<Window x:Class="FootNote.App.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="Welcome to FootNote" Width="520" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#1E1E2B">

    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="Dim" Color="#9B9BA8"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#28283A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                         Fill="{StaticResource BrandMarkBrush}"/>
                <TextBlock Text="Welcome to FootNote" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Step 1: what it does, one line -->
            <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="{StaticResource Dim}"
                       TextWrapping="Wrap" LineHeight="20"
                       Text="FootNote attaches a personal note to any file or folder — stored with the item itself, shown the moment you click it."/>

            <!-- Step 2: the verified lesson -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Try it now" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Margin="0,6,0,10" FontSize="12.5" Foreground="{StaticResource Dim}"
                               TextWrapping="Wrap"
                               Text="Select any file in Explorer or on your desktop, then press:"/>
                    <Border Background="#3D3D4D" CornerRadius="8" Padding="16,9"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="HotkeyChip" Text="Shift + Alt + N" FontSize="17"
                                   FontWeight="Bold" FontFamily="Consolas"/>
                    </Border>
                    <Border x:Name="StatusPill" Background="#3D3D4D" CornerRadius="999"
                            Padding="12,4" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock x:Name="StatusText" Text="waiting…" FontSize="12"
                                   Foreground="{StaticResource Dim}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Demo GIF fallback -->
            <TextBlock Margin="2,12,0,0" FontSize="12.5">
                <Hyperlink x:Name="DemoLink" Foreground="#6BA1F8" Click="DemoLink_Click">Or watch a quick demo</Hyperlink>
            </TextBlock>
            <Border x:Name="DemoPanel" Visibility="Collapsed" Margin="0,8,0,0"
                    CornerRadius="8" Background="#101018" Padding="6">
                <Image gif:ImageBehavior.AnimatedSource="/Assets/footnote_demo.gif"
                       gif:ImageBehavior.RepeatBehavior="Forever" Height="180"/>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,14,0,0">
            <Button x:Name="SkipBtn" DockPanel.Dock="Right" Content="Skip" Padding="18,7"
                    Background="#3D3D4D" Foreground="{StaticResource Text}" BorderThickness="0"
                    Click="Skip_Click"/>
        </DockPanel>
    </Grid>
</Window>
