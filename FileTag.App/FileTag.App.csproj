<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>5.1.0</Version>
    <ApplicationIcon>filetag.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>FileTag</AssemblyTitle>
    <Product>FileTag</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileTag.Core\FileTag.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- embedded, never fetched over the network -->
    <Resource Include="Assets\filetag_demo.gif" />
  </ItemGroup>

</Project>
