<Window x:Class="FileTag.App.RecoverNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover Notes" Width="620" Height="480" MinHeight="320"
        WindowStartupLocation="CenterScreen" Background="#1E1E2B">

    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="Dim" Color="#9B9BA8"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#28283A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="RestoreBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Background" Value="#4F8EF7"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Recover Notes" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,14" FontSize="12.5" Foreground="{StaticResource Dim}"
                   TextWrapping="Wrap"
                   Text="Notes that no longer have a live comment, from FileTag's local backup. Restoring adds the text back as a new entry — nothing already on the file is overwritten."/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsPanel"/>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Foreground="{StaticResource Dim}" FontSize="13"
                   Visibility="Collapsed" Text="Nothing to recover — every backed-up note is either still live or its file is gone."/>

        <Button Grid.Row="3" Content="Close" HorizontalAlignment="Right" Padding="18,7" Margin="0,14,0,0"
                Background="#3D3D4D" Foreground="{StaticResource Text}" BorderThickness="0" Click="Close_Click"/>
    </Grid>
</Window>
